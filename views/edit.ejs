<div class="container">
  <h2>글 수정</h2>
  <form action="/post/<%= post._id %>?_method=PUT" method="POST">
    <input type="hidden" name="_token" value="<%= token %>" />
    <label>카테고리 선택:</label>
    <select name="category" required>
      <% categories.forEach(cat => { %>
        <option value="<%= cat.name %>" <%= post.category === cat.name ? "selected" : "" %>>
          <%= cat.name %>
        </option>
      <% }) %>
    </select>
    <select name="status" required>
      <option value="" <%= !post.status ? "selected" : "" %>>상태</option>
      <option value="public" <%= post.status === 'public' ? "selected" : "" %>>공개</option>
      <option value="private" <%= post.status === 'private' ? "selected" : "" %>>비공개</option>
    </select>
    <input type='radio' name='is_markdown' id="write-html" value='0' <%= !post.isMarkdown ? "checked" : "" %> />
    <label for="write-html">HTML</label>
    <input type='radio' name='is_markdown' id="write-md" value='1' <%= post.isMarkdown ? "checked" : "" %> />
    <label for="write-md">Markdown</label>
    <br /><br />
    <input type="text" name="title" value="<%= post.title %>" placeholder="제목" style="width:100%;box-sizing:border-box" required /><br /><br />
    <textarea name="content" id="summernote" placeholder="내용" required><%= post.content %></textarea><br /><br />
    <script>
      $(document).ready(function() {
        let simplemde = null;

        const currentMode = () => {
          const writeMode = parseInt($('input[name="is_markdown"]:checked').val());
          if (writeMode) {
            $('#summernote').summernote('destroy');
            simplemde = new SimpleMDE({ spellChecker: false });
          } else {
            simplemde.toTextArea();
            simplemde = null;
            $('#summernote').summernote();
          }
        }

        $('input[name="is_markdown"]:radio').change(function(){
          currentMode();
        });

        currentMode();
      });
    </script>
    <button type="submit">수정 완료</button>
  </form>
</div>
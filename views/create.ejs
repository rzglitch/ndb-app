<div class="container">
  <h2>새 글 작성</h2>
  <form action="/" method="POST">
    <input type="hidden" name="_token" value="<%= token %>" />
    <label>카테고리 선택:</label>
    <select name="category" required>
      <% categories.forEach(cat => { %>
        <option value="<%= cat.name %>"><%= cat.name %></option>
      <% }) %>
    </select>
    <select name="status" required>
      <option value="">상태</option>
      <option value="public">공개</option>
      <option value="private" selected>비공개</option>
    </select>
    <input type='radio' name='is_markdown' id="write-html" value='0' checked />
    <label for="write-html">HTML</label>
    <input type='radio' name='is_markdown' id="write-md" value='1' />
    <label for="write-md">Markdown</label><br /><br />
    <br /><br />
    <input type="text" name="title" placeholder="제목" style="width:100%;box-sizing:border-box" required /><br /><br />
    <textarea name="content" id="summernote" placeholder="내용" required></textarea><br /><br />
    <script>
      $(document).ready(function() {
        $('#summernote').summernote();
        let simplemde = null;

        $('input[name="is_markdown"]:radio').change(function(){
          const writeMode = parseInt($('input[name="is_markdown"]:checked').val());

          if (writeMode) {
            $('#summernote').summernote('destroy');
            simplemde = new SimpleMDE({ spellChecker: false });
          } else {
            simplemde.toTextArea();
            simplemde = null;
            $('#summernote').summernote();
          }
        });
      });
    </script>
    <button type="submit">등록</button>
  </form>
</div>

<form action="/" method="POST">
  <div>
    <input type="hidden" name="_token" value="<%= token %>" />

    <!-- Top Bar -->
    <div class="border-b bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">

        <h1 class="text-lg font-semibold">새 글 작성</h1>

        <div class="flex items-center gap-3">
          <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800">
            등록
          </button>
        </div>
      </div>
    </div>

    <!-- Editor -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">

      <!-- Title -->
      <input
        type="text"
        name="title"
        placeholder="제목을 입력하세요"
        class="w-full text-3xl sm:text-4xl font-bold border-none outline-none placeholder-gray-300"
      />

      <hr class="my-8" />

      <!-- Meta -->
      <div class="flex flex-wrap gap-3 mb-8">
        <select name="category" required>
          <option value="" selected>카테고리</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.name %>"><%= cat.name %></option>
          <% }) %>
        </select>
        <select name="status" required>
          <option value="">상태</option>
          <option value="public">공개</option>
          <option value="private" selected>비공개</option>
        </select>
        <input type='radio' name='is_markdown' id="write-html" value='0' checked />
        <label for="write-html">HTML</label>
        <input type='radio' name='is_markdown' id="write-md" value='1' />
        <label for="write-md">Markdown</label>
      </div>

      <!-- Content -->
      <textarea name="content" id="summernote" placeholder="내용" required
        class="w-full min-h-[200px] resize-none border-none outline-none text-lg leading-relaxed placeholder-gray-400"></textarea>

      <script>
        $(document).ready(function() {
          let simplemde = null;

          const currentMode = () => {
            const writeMode = parseInt($('input[name="is_markdown"]:checked').val());
            if (writeMode) {
              $('#summernote').summernote('destroy');
              simplemde = new SimpleMDE({ spellChecker: false });
            } else {
              if (simplemde) {
                simplemde.toTextArea();
                simplemde = null;
              }
              $('#summernote').summernote();
            }
          }

          $('input[name="is_markdown"]:radio').change(function(){
            currentMode();
          });

          currentMode();
        });
      </script>

    </div>
  </div>
</form>

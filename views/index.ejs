<section class="py-16">
  <div class="max-w-5xl mx-auto px-6">

    <!-- Section Header -->
    <div class="mb-10">
      <h2 class="text-3xl font-bold text-gray-900">글 목록</h2>
    </div>

    <!-- Blog List -->
    <%- t %>

    <div class="mt-12 flex items-center justify-center">
      <nav class="flex items-center gap-1">
        <div class="hidden sm:flex items-center gap-1">
          <% if (currentPage> 1) { %>
              <a href="/?page=<%= currentPage - 1 %><% if (category) { %>&category=<%= category %><% } %>"
                class="px-2 flex items-center justify-center rounded-lg border text-gray-500 hover:bg-gray-100">‹</a>
          <% } %>

          <% for (let i=1; i <=totalPages; i++) { %>
            <% if (i===currentPage) { %>
              <a href="/?page=<%= i %><% if (category) { %>&category=<%= category %><% } %>"
                  class="px-2 rounded-lg bg-black text-white">
                <%= i %>
              </a>
            <% } else { %>
              <a href="/?page=<%= i %><% if (category) { %>&category=<%= category %><% } %>"
                  class="px-2 rounded-lg border text-gray-600 hover:bg-gray-100">
                <%= i %>
              </a>
            <% } %>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a
              href="/?page=<%= currentPage + 1 %><% if (category) { %>&category=<%= category %><% } %>"
              class="px-2 flex items-center justify-center rounded-lg border text-gray-500 hover:bg-gray-100">›</a>
          <% } %>
        </div>
      </nav>
    </div>
  </div>
</section>
